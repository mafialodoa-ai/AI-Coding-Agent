{
  "model": {
    "name": "bert-base-multilingual-cased",
    "hidden_size": 768,
    "num_hidden_layers": 12,
    "num_attention_heads": 12,
    "intermediate_size": 3072
  },
  "training": {
    "batch_size": 32,
    "epochs": 10,
    "learning_rate": 2e-5,
    "warmup_steps": 500,
    "max_seq_length": 512
  },
  "data": {
    "dataset_size": 2048,
    "train_split": 0.8,
    "val_split": 0.1,
    "test_split": 0.1,
    "languages": ["bengali", "english"]
  },
  "output": {
    "model_dir": "./models",
    "logs_dir": "./logs",
    "checkpoint_dir": "./checkpoints"
  }
}